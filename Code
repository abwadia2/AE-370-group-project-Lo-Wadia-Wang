tb_test = 5.25
refine = np.array([1, 2, 4, 8, 16])
N_base = 200
dt_coast_base = 0.01

def run_with_refinement(r):
    apogee, _ = simulate(
        tb_test,
        N=N_base * r,
        dt_coast=dt_coast_base / r
    )
    return apogee

h_ref = run_with_refinement(64)

dts = (tb_test - t_ramp) / (N_base * refine)
heights = np.array([run_with_refinement(r) for r in refine])
errors = np.abs(heights - h_ref)

print("dt [s]       apogee [m]       error [m]       observed order")
for i in range(len(refine)):
    if i == 0 or errors[i] == 0 or errors[i - 1] == 0:
        order = "—"
    else:
        order = f"{np.log2(errors[i - 1] / errors[i]):.2f}"

    print(f"{dts[i]:10.6f}   {heights[i]:14.8f}   {errors[i]:.3e}   {order}")

plt.figure(figsize=(6, 4.5))
plt.loglog(dts, errors, "o-", label="Apogee error vs. fine reference")
plt.loglog(
    dts,
    errors[0] * (dts / dts[0])**4,
    "k--",
    label=r"Fourth-order guide ($\Delta t^4$)"
)
plt.xlabel(r"Burn-phase step size $\Delta t$ [s]")
plt.ylabel("Apogee error [m]")
plt.legend()
plt.grid(alpha=0.3, which="both")
plt.show()

