def test_rhs(t, y, P):
    h, v = y
    mass = P["m0"] - P["mdot"] * t
    return np.array([
        v,
        P["ve"] * P["mdot"] / mass - P["g"]
    ])


P_test = {
    "m0": 1.0,
    "mdot": 0.02,
    "ve": 1200.0,
    "g": 9.81
}

final_time = 5.0
steps = [10, 20, 40, 80]
dt_values = []
errors = []

mass_final = P_test["m0"] - P_test["mdot"] * final_time

exact_v = (
    P_test["ve"] * np.log(P_test["m0"] / mass_final)
    - P_test["g"] * final_time
)

exact_h = (
    P_test["ve"] / P_test["mdot"]
    * (
        P_test["m0"] - mass_final
        - mass_final * np.log(P_test["m0"] / mass_final)
    )
    - 0.5 * P_test["g"] * final_time**2
)

for N in steps:
    dt = final_time / N
    y = np.array([0.0, 0.0])

    for i in range(N):
        y = rk4_step(i * dt, y, dt, P_test, rhs_function=test_rhs)

    error = np.sqrt((y[0] - exact_h)**2 + (y[1] - exact_v)**2)
    dt_values.append(dt)
    errors.append(error)

dt_values = np.array(dt_values)
errors = np.array(errors)

print("dt, error, observed order")
for i in range(len(steps)):
    if i == 0:
        print(dt_values[i], errors[i], "-")
    else:
        order = np.log2(errors[i - 1] / errors[i])
        print(dt_values[i], errors[i], order)

plt.loglog(dt_values, errors, "o-", label="RK4 error")
plt.loglog(
    dt_values,
    errors[0] * (dt_values / dt_values[0])**4,
    "--",
    label="Fourth-order reference"
)
plt.xlabel("Time step")
plt.ylabel("Error against exact solution")
plt.grid(True, which="both")
plt.legend()
plt.show()    
